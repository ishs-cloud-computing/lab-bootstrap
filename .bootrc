# .bootrc
#
# bootstrap.ps1 splices this file into your pwsh profile between its markers. It is NOT run by
# the installer; it runs in every new pwsh session, like a profile, because it becomes one.
# Edit freely and re-run bootstrap.ps1 to apply. Plain PowerShell, no special syntax.

Set-Alias g  git
Set-Alias k  kubectl
Set-Alias tf terraform

# Tab completion for kubectl / helm / eksctl / k9s is generated at install time and loaded
# after this file, so the aliases above pick it up automatically. Nothing to do here.

# Terraform ships no PowerShell completion generator ('-install-autocomplete' writes bash and
# zsh only), so this is hand-rolled from the documented subcommand list.
$tfCmds = 'init','validate','plan','apply','destroy','fmt','show','output','state',
          'import','workspace','providers','refresh','taint','untaint','console',
          'graph','login','logout','test','version'
Register-ArgumentCompleter -Native -CommandName terraform,tf -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    # Only the first argument is a subcommand; past that we have nothing useful to say.
    if ($commandAst.CommandElements.Count -gt 2) { return }
    $tfCmds | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
        [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
    }
}

# git completion is deliberately absent: doing it properly needs posh-git from the PSGallery,
# and one more dependency on the lab network is not worth it.
